{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/outilCandidature/*" }, { "path": "$DOWNLOAD/*" }, { "path": "$DOCUMENT/*" }]
    },
    "dialog:default"
  ]
}
